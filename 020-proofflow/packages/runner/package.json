{
  "name": "@proofflow/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": { "proofflow-runner": "./dist/main.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
