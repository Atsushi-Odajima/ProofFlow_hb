    "@axe-core/playwright": "4.13.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "jszip": "3.10.2",
    "ajv": "8.17.1"
  },
  "devDependencies": { "@types/pngjs": "6.0.5" }
}
