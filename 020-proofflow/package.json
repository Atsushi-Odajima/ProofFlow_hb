{
  "name": "proofflow",
  "version": "0.1.0",
  "private": true,
  "description": "ProofFlow — Web サイト・アプリ品質検証／受入テスト基盤 (商品 #020)",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "dev:server": "pnpm --filter @proofflow/server dev",
    "dev:runner": "pnpm --filter @proofflow/runner dev",
    "dev:web": "pnpm --filter @proofflow/web dev",
    "dev:sample": "pnpm --filter @proofflow/sample-saas dev",
    "seed:sample": "pnpm --filter @proofflow/server seed:sample",
    "lint": "tsc -b --noEmit false -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
