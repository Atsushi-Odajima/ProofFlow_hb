# ProofFlow control plane (API + Web UI + queue + scheduler). Build from the repository root:
#   docker build -f deploy/Dockerfile.server -t proofflow-server .
FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY tests/package.json ./tests/package.json
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @proofflow/shared build && pnpm --filter @proofflow/server build && pnpm --filter @proofflow/web build

FROM node:22-bookworm-slim
ENV NODE_ENV=production PROOFFLOW_HOST=0.0.0.0 PROOFFLOW_PORT=8080 PROOFFLOW_DATA_DIR=/data
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate && useradd -m -u 10001 proofflow
WORKDIR /app
COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/.npmrc ./
COPY --from=build /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/server/package.json ./packages/server/package.json
COPY --from=build /app/packages/server/dist ./packages/server/dist
COPY --from=build /app/packages/web/dist ./packages/web/dist
# production deps only (playwright is optional for the server: PDF report rendering; omitted here to keep the image small)
RUN pnpm install --prod --frozen-lockfile --filter @proofflow/server... --config.optional=false && mkdir -p /data && chown -R proofflow /data
USER proofflow
VOLUME ["/data"]
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s CMD node -e "fetch('http://127.0.0.1:8080/api/v1/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "packages/server/dist/main.js"]
