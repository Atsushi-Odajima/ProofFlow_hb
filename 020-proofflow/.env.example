# ProofFlow control plane
PROOFFLOW_PORT=8080
PROOFFLOW_PUBLIC_URL=http://localhost:8080
PROOFFLOW_DATA_DIR=./data
# sqlite (default) | postgres
PROOFFLOW_DB_DRIVER=sqlite
PROOFFLOW_DATABASE_URL=
# 32-byte base64 master key for the Secret Vault (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
PROOFFLOW_MASTER_KEY=
# HMAC secret for signed artifact URLs and session cookies
PROOFFLOW_SIGNING_SECRET=
# AI plane: none | openai | anthropic
PROOFFLOW_AI_PROVIDER=none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Runner
PROOFFLOW_RUNNER_TOKEN=
PROOFFLOW_CONTROL_URL=http://localhost:8080
PROOFFLOW_RUNNER_CONCURRENCY=2
